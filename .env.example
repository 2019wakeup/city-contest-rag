# ===== LLM（DeepSeek，OpenAI 兼容）=====
# 未配置或 LLM_OFF=1 时报告自动降级为模板文案（llmStatus: degraded）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_OFF=0

# ===== 模块 A / 模块 C 队友服务 =====
# 留空 = 使用内置 mock（确定性、可复现；响应标 adapterMode: mock）
MODULE_A_ENDPOINT=
MODULE_C_ENDPOINT=

# ===== 检索后端：lancedb（默认）| sqlite =====
RETRIEVAL_BACKEND=lancedb

# ===== HuggingFace 模型下载镜像（embedding 首次使用需联网）=====
HF_ENDPOINT=https://hf-mirror.com

# ===== Embedding 模型：bge-m3（默认，1024 维）| multilingual-e5-small（384 维）=====
# 换模型后需重新执行 pnpm build:index（provenance 会强制全量重建，防维度不匹配）
EMBEDDING_MODEL=bge-m3

# ===== e5 系列 query/passage 前缀：auto（默认，e5 开 bge 关）| off =====
EMBEDDING_PREFIX_MODE=auto

# ===== 服务端口（Vite proxy 固定指向 3000）=====
PORT=3000
