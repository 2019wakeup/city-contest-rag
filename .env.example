# ===== LLM（DeepSeek，OpenAI 兼容）=====
# 未配置或 LLM_OFF=1 时报告自动降级为模板文案（llmStatus: degraded）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_OFF=0

# ===== 模块 A / 模块 C 队友服务 =====
# 留空 = 使用内置 mock（确定性、可复现；响应标 adapterMode: mock）
MODULE_A_ENDPOINT=
MODULE_C_ENDPOINT=

# ===== 检索后端：lancedb（默认）| sqlite =====
RETRIEVAL_BACKEND=lancedb

# ===== HuggingFace 模型下载镜像（bge-m3 首次使用需联网）=====
HF_ENDPOINT=https://hf-mirror.com

# ===== 服务端口（Vite proxy 固定指向 3000）=====
PORT=3000
